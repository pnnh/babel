{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "installDir": "${sourceDir}/install/linux",
      "toolchainFile": "$env{HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.11.1/gcc_64;$env{HOME}/vcpkg/installed/x64-linux/share"
      },
      "environment": {
        "Qt6_DIR": "$env{HOME}/Qt/6.11.1/gcc_64/lib/cmake/Qt6"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS Config",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/macos",
      "installDir": "${sourceDir}/install/macos",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "VCPKG_HOST_TRIPLET": "arm64-osx",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_CXX_COMPILER_LAUNCHER": "/opt/homebrew/bin/ccache",
        "CMAKE_C_COMPILER_LAUNCHER": "/opt/homebrew/bin/ccache",
        "CMAKE_OSX_SYSROOT": "macosx",
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.12.0/macos"
      },
      "environment": {}
    },
    {
      "name": "windows",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows",
      "installDir": "${sourceDir}/install/windows",
      "toolchainFile": "$env{VCPKG_ROOT}\\scripts\\buildsystems\\vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "C:\\Qt\\6.11.0\\msvc2022_64\\lib\\cmake"
      },
      "environment": {}
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "windows",
      "configurePreset": "windows"
    }
  ]
}